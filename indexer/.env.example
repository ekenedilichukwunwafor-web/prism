# Postgres connection string
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism

# Soroban RPC endpoint to poll. Required — no silent testnet fallback in production.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# How often to poll for new ledgers, in milliseconds. Must be a positive integer.
POLL_INTERVAL_MS=5000

# Port for the health (/healthz) and metrics (/metrics) HTTP endpoints.
HEALTH_PORT=8080

# Unhealthy when the indexer cursor trails the network by more than this many ledgers.
HEALTH_MAX_LEDGER_LAG=60

# Optional: first ledger to index on a fresh database. Must fall inside the RPC node's
# retention window. Ignored once the indexer has a cursor. Unset: start from the latest ledger.
# INDEXER_START_LEDGER=

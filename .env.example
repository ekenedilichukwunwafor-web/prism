# Copy to .env to override the defaults used by docker-compose.yml:
#   cp .env.example .env
# Every value below is the default that compose uses when the variable is unset.

# Stellar network: "testnet", "mainnet", or "futurenet".
NEXT_PUBLIC_NETWORK=testnet

# Horizon REST API endpoint. Compose defaults to the testnet endpoint, so set
# this and the Soroban RPC URL together when pointing at mainnet or futurenet.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint. The indexer polls the same URL.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Public site URL, used to build absolute OG/social image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres pool used by the indexer-backed views (frontend/src/lib/indexed-db.ts).
# Compose points this at its own "postgres" service; set DATABASE_URL in your
# .env to use a managed instance instead, e.g. postgresql://user:pass@host:5432/prism
# DATABASE_URL=postgresql://prism:prism@localhost:5432/prism

# Maximum number of pooled connections. Default: 10.
DATABASE_POOL_MAX=10

# Close idle connections after this many milliseconds. Default: 10000 (10s).
DATABASE_IDLE_TIMEOUT_MS=10000

# TLS for DATABASE_URL. "true" verifies the server certificate, "no-verify"
# encrypts without verifying it (for providers whose CA is not trusted by Node),
# and "false" disables TLS. Default: false.
DATABASE_SSL=false
